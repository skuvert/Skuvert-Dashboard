generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternalStatus {
  NEU
  ANGEBOT_ERSTELLT
  ANGEBOT_VERSENDET
  BESTAETIGT_BEZAHLT
  IN_PRODUKTION
  FERTIG
  VERSENDET
  ABGESCHLOSSEN
  STORNIERT
}

enum CustomerStatus {
  ANFRAGE_ERHALTEN
  ANGEBOT_GESENDET
  IN_PRODUKTION
  VERSANDBEREIT
  VERSENDET
  ABGESCHLOSSEN
}

enum LedgerType {
  IN
  OUT
}

enum FilamentMaterial {
  PLA
  PETG
  ABS
  TPU
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  customerName   String
  customerEmail  String
  rawRequestText String
  orderTypes     String[]

  internalStatus InternalStatus @default(NEU)
  customerStatus CustomerStatus @default(ANFRAGE_ERHALTEN)

  trackingToken   String  @unique
  paymentLink     String?
  // Freitext-Notiz für den Kunden (z. B. "12 von 40 fertiggestellt").
  // Wird – falls gesetzt – in der öffentlichen Status-Ansicht angezeigt.
  customerNote    String?
  shippingAddress String?
  trackingNumber   String?
  materialGrams    Float?
  packagingCostChf Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes          Note[]
  costItems      CostItem[]
  checklistItems ChecklistItem[]
  ledgerEntries  LedgerEntry[]
}

model Note {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model CostItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  qty       Float  @default(1)
  unit      String @default("")
  unitPrice Float
  // "line" (Standard) | "discountPct" (unitPrice = Prozent) | "discountFixed" (unitPrice = CHF)
  kind      String @default("line")
  sortOrder Int    @default(0)
}

model ChecklistItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  isDefault Boolean   @default(false)
  isChecked Boolean   @default(false)
  checkedAt DateTime?
  sortOrder Int       @default(0)
}

model PostPriceRow {
  id              String @id @default(cuid())
  weightClass     String
  destinationZone String
  price           Float
  sortOrder       Int    @default(0)
}

model OwnPriceRow {
  id        String  @id @default(cuid())
  label     String
  unit      String
  price     Float
  note      String?
  sortOrder Int     @default(0)
}

// Buchhaltung: gleiches Datenmodell wie das frühere localStorage-Tool
// (Datum/Art/Betrag/Kategorie/Beschreibung/Kunde/Beleg) + optionale
// Verknüpfung zu einem Auftrag.
model LedgerEntry {
  id          String     @id @default(cuid())
  date        DateTime
  type        LedgerType
  amount      Float
  category    String     @default("")
  description String     @default("")
  party       String     @default("")
  receipt     Boolean    @default(true)
  // auto = aus einem Auftrag abgeleitet (Material/Strom/Abnutzung/Verpackung/Einnahme).
  // Diese Zeilen werden bei jeder Auftragsänderung neu berechnet; manuelle
  // Einträge (auto = false) bleiben unangetastet.
  auto        Boolean    @default(false)
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([orderId])
}

// Filament-Bestand. Eine Zeile pro Material+Farbe; count = Anzahl 1-kg-Spulen.
// Quelle der Wahrheit für die Material-/Farbauswahl auf der öffentlichen Website
// (über die read-only Route /api/filament). count = 0 → auf der Website ausgeblendet.
model FilamentSpool {
  id        String           @id @default(cuid())
  material  FilamentMaterial
  colorName String
  // CSS-Wert für die Farbvorschau (Hex wie "#1a1a1a" ODER ein Gradient-String
  // wie bei "Durchsichtig") — wird 1:1 als background auf der Website genutzt.
  colorHex  String           @default("#9ca3af")
  count     Int              @default(1)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([material, colorName])
}

// Einzeiliger Datensatz für den PDF-Kopf der Abrechnung (früher localStorage-"profile").
model LedgerProfile {
  id    String @id @default("default")
  name  String @default("")
  addr  String @default("")
  taxId String @default("")
  place String @default("")
  iban  String @default("")
}

// Serverseitige Ratenbegrenzung der Login-Versuche (pro IP).
model LoginAttempt {
  ip          String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
