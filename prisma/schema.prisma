generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternalStatus {
  NEU
  ANGEBOT_ERSTELLT
  ANGEBOT_VERSENDET
  BESTAETIGT_BEZAHLT
  IN_PRODUKTION
  FERTIG
  VERSENDET
  ABGESCHLOSSEN
  STORNIERT
}

enum CustomerStatus {
  ANFRAGE_ERHALTEN
  ANGEBOT_GESENDET
  IN_PRODUKTION
  VERSANDBEREIT
  VERSENDET
  ABGESCHLOSSEN
}

enum LedgerType {
  IN
  OUT
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  customerName   String
  customerEmail  String
  rawRequestText String
  orderTypes     String[]

  internalStatus InternalStatus @default(NEU)
  customerStatus CustomerStatus @default(ANFRAGE_ERHALTEN)

  trackingToken   String  @unique
  paymentLink     String?
  shippingAddress String?
  trackingNumber  String?
  materialGrams   Float?
  materialCostChf Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes          Note[]
  costItems      CostItem[]
  checklistItems ChecklistItem[]
  ledgerEntries  LedgerEntry[]
}

model Note {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model CostItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  qty       Float  @default(1)
  unitPrice Float
  sortOrder Int    @default(0)
}

model ChecklistItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  isDefault Boolean   @default(false)
  isChecked Boolean   @default(false)
  checkedAt DateTime?
  sortOrder Int       @default(0)
}

model PostPriceRow {
  id              String @id @default(cuid())
  weightClass     String
  destinationZone String
  price           Float
  sortOrder       Int    @default(0)
}

model OwnPriceRow {
  id        String  @id @default(cuid())
  label     String
  unit      String
  price     Float
  note      String?
  sortOrder Int     @default(0)
}

// Buchhaltung: gleiches Datenmodell wie das frühere localStorage-Tool
// (Datum/Art/Betrag/Kategorie/Beschreibung/Kunde/Beleg) + optionale
// Verknüpfung zu einem Auftrag.
model LedgerEntry {
  id          String     @id @default(cuid())
  date        DateTime
  type        LedgerType
  amount      Float
  category    String     @default("")
  description String     @default("")
  party       String     @default("")
  receipt     Boolean    @default(true)
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([orderId])
}

// Einzeiliger Datensatz für den PDF-Kopf der Abrechnung (früher localStorage-"profile").
model LedgerProfile {
  id    String @id @default("default")
  name  String @default("")
  addr  String @default("")
  taxId String @default("")
  place String @default("")
  iban  String @default("")
}

// Serverseitige Ratenbegrenzung der Login-Versuche (pro IP).
model LoginAttempt {
  ip          String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
