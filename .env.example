# Verbindungsstring zu deiner Postgres-Datenbank (z.B. von Neon).
# Für Neon empfiehlt sich die "pooled" Connection-String-Variante.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Passwort-Hash + Session-Secret für den internen Admin-Bereich — OPTIONAL.
# Ohne diese Variablen nutzt die App den Fallback aus lib/admin-config.ts
# (dort ist der aktuelle Passwort-Hash hinterlegt), damit der Login auch ohne
# Env-Setup funktioniert. Wer es strenger will (Secrets nicht im Repo), setzt
# beide hier bzw. in Vercel — dann gewinnen sie gegenüber dem Fallback.
# Werte erzeugen: `npx tsx scripts/hash-password.ts "<passwort>"`.
# Niemals das Klartext-Passwort committen, nur den Hash.
# ADMIN_PASSWORD_HASH="salt-hex:hash-hex"
# SESSION_SECRET="langer-zufaelliger-string"
