# Verbindungsstring zu deiner Postgres-Datenbank (z.B. von Neon).
# Für Neon empfiehlt sich die "pooled" Connection-String-Variante.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Passwort-Hash + Session-Secret für den internen Admin-Bereich.
# Beide mit `npx tsx scripts/hash-password.ts` erzeugen (Passwort selbst wählen)
# und die ausgegebenen Werte hier UND in Vercel eintragen.
# Niemals das Klartext-Passwort committen.
ADMIN_PASSWORD_HASH="salt-hex:hash-hex"
SESSION_SECRET="langer-zufaelliger-string"
