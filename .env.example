# Verbindungsstring zu deiner Postgres-Datenbank (z.B. von Neon).
# Für Neon empfiehlt sich die "pooled" Connection-String-Variante.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Das einzige Passwort für den internen Admin-Bereich (frei wählbar).
ADMIN_PASSWORD="dein-passwort-hier"
